    "on copy" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "khi copy"
          }
        }
      }
    },
    "⌘V anywhere pastes the result, not just pasting from NovaClipboard. The clipboard then holds plain text only; the original stays in history (⌥↵ pastes it)." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘V ở bất kỳ đâu cũng paste kết quả, không chỉ khi paste từ NovaClipboard. Khi đó clipboard chỉ còn văn bản thuần; bản gốc vẫn nằm trong lịch sử (⌥↵ để paste bản gốc)."
          }
        }
      }
    },
